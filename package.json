{
  "name": "automation_ldc",
  "version": "1.0.0",
  "description": "Playwright Automation Framework",
  "main": "index.js",
  "type": "commonjs",
  "author": "",
  "license": "ISC",
  "scripts": {
    "test": "playwright test",
    "report": "playwright test",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "test:allure": "playwright test && npm run allure:generate && npm run allure:open",
    "clean:reports": "rimraf allure-results allure-report playwright-report test-results reports",
    "test:3003:full": "playwright test tests/degree/ALB-UMT/ALB_MSB_3003.spec.ts --headed --workers=1",
    "test:degree:full": "playwright test tests/degree/ALB-UMT/ALB_MSB_3003.spec.ts tests/degree/ALB-UMT/ELF_ALB-BIO_2581.spec.ts --headed --workers=1",
    "test:3003:smoke": "playwright test tests/degree/ALB-UMT/ALB_MSB_3003.spec.ts -g \"TC_P_01|TC_N_01\" --headed --workers=1 --no-deps"
  },
  "keywords": [],
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.60.0",
    "@types/archiver": "^7.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/dotenv": "^8.2.0",
    "@types/node": "^25.8.0",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.10.0",
    "allure-playwright": "^3.10.0",
    "dotenv": "^16.6.1",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "fs-extra": "^11.3.5",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "papaparse": "^5.5.4"
  }
}
